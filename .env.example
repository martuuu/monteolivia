# ---------------------------------------------------------------
# Monte Olivia Suites · variables de entorno
# Copiar a .env.local para desarrollo. En Vercel: Settings → Environment Variables.
# ---------------------------------------------------------------

# URL canónica del sitio (sin barra final). Se usa en metadata, sitemap, JSON-LD y OG.
NEXT_PUBLIC_SITE_URL=https://monteoliviasuites.com.ar

# Google Analytics 4 · Measurement ID (Admin → Flujos de datos → Web). Vacío = GA desactivado.
NEXT_PUBLIC_GA_ID=

# Resend · envío del formulario "Dejar comentario". Vacío = el formulario cae a mailto:.
RESEND_API_KEY=
# Remitente verificado en Resend (dominio propio) y destinatario de las reseñas.
REVIEW_FROM_EMAIL=Monte Olivia Suites <web@monteoliviasuites.com.ar>
REVIEW_TO_EMAIL=info@monteoliviasuites.com.ar

# Modo mantenimiento: "1" devuelve 503 + página de mantenimiento en todo el sitio (requiere redeploy).
MAINTENANCE_MODE=0

# GA4 DebugView: "1" envía debug_mode (solo para pruebas, no dejar en producción)
NEXT_PUBLIC_GA_DEBUG=0
