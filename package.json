    "og:build": "node scripts/build-og.mjs",
    "qa:shots": "node scripts/qa/screenshot.mjs http://localhost:3000 qa-shots / /departamentos /departamentos/departamento-1 /en",
    "brand:logo": "node scripts/build-logo-white.mjs && node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.3",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
